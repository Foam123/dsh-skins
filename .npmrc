# The six @deepseek-ai/dsh-client-* peers are DECLARATION-ONLY for the DSH
# ecosystem's compatibility gate (know-how 034): the real client modules ship
# inside the DSH runtime, and the npm stubs top out at 0.1.1-rc.2 — well below
# the peer floor ">=0.2.0-rc.1 || >=0.2.1-rc.1". Auto-installing root peers
# would try to resolve those ranges against the stub registry and fail.
auto-install-peers=false
